# Supabase project settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Legacy projects can still use VITE_SUPABASE_ANON_KEY instead.
# The browser key is intentionally public; Row Level Security is the boundary.
# Never put a service-role key in a VITE_* variable.
VITE_SUPABASE_ANON_KEY=

# Used only by scripts/seed.ts on your machine. Never imported by the app.
# Prefer the modern secret key. Legacy projects may still use service_role.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
